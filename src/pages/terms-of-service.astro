---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { footerLinks } from '../data/footerLinks';

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'Blog', href: '/blog' },
];
---

<BaseLayout title="Terms of Service — Munglabs">
  <Navbar links={navLinks} />
  <main id="main">
    <article class="pt-28 pb-20 px-6">
      <div class="max-w-3xl mx-auto">
        <header class="mb-10">
          <span class="text-sm font-medium text-mung-600 tracking-wide uppercase">Legal</span>
          <h1 class="mt-3 text-3xl sm:text-4xl font-bold text-slate-900 tracking-tight">
            Terms of Service
          </h1>
          <p class="mt-4 text-lg text-slate-500">
            Last updated: September 25, 2026
          </p>
        </header>

        <div class="prose prose-slate max-w-none">
          <p>
            Welcome to Munglabs ("we", "us", or "our"). These Terms of
            Service ("Terms") govern your use of the Website at
            <a href="https://munglabs.com">https://munglabs.com</a> and any
            related services we offer (together, the "Service"). By accessing
            or using the Service, you agree to be bound by these Terms. If you
            do not agree, do not use the Service.
          </p>

          <h2>1. The Service</h2>
          <p>
            Munglabs provides a website and related tools for content,
            research, and community purposes. We may add or remove features at
            any time.
          </p>

          <h2>2. Accounts and eligibility</h2>
          <ul>
            <li>You may use the Service only if you are at least 13 years old.</li>
            <li>
              To sign in, we use Google Sign-In (Google OAuth) and collect only
              your name and email address. You are responsible for maintaining
              the confidentiality of your Google Account credentials and for
              all activity that occurs under your account.
            </li>
            <li>
              We only store the name and email address associated with the
              Google Account you use to sign in. See our
              <a href="/privacy-policy">Privacy Policy</a> for details.
            </li>
            <li>
              You may revoke access at any time through your Google Account
              settings (Security &gt; Third-party apps &amp; account access).
            </li>
          </ul>

          <h2>3. Acceptable use</h2>
          <p>You agree not to:</p>
          <ul>
            <li>Use the Service in violation of any applicable law or regulation.</li>
            <li>Attempt to gain unauthorized access to the Service, its infrastructure, or data.</li>
            <li>Interfere with or disrupt the Service or servers and networks connected to it.</li>
            <li>Harass, abuse, or harm other users or persons.</li>
            <li>Use the Service to distribute malware or malicious code.</li>
            <li>Circumvent any rate limits, access controls, or usage restrictions.</li>
          </ul>

          <h2>4. User content</h2>
          <p>
            If you submit content (comments, posts, or other material) through
            the Service, you grant us a license to host, display, and distribute
            that content as necessary to operate the Service. You are
            responsible for what you submit. We may remove content that we
            reasonably believe violates these Terms or that is harmful, abusive,
            or infringes the rights of others.
          </p>

          <h2>5. Intellectual property</h2>
          <p>
            The Service, including its design, text, graphics, logos, and
            software, is owned by Munglabs or its licensors and is protected by
            applicable intellectual property laws. You may not reproduce,
            distribute, or create derivative works without prior written
            permission, except as permitted by law.
          </p>

          <h2>6. Third-party services</h2>
          <p>
            The Service may include links to or use of third-party services
            (for example, Google Sign-In and Giscus blog comments). Those
            services are governed by their own terms and privacy policies, and
            Munglabs is not responsible for their content or practices.
          </p>

          <h2>7. Disclaimers</h2>
          <p>
            The Service is provided on an "as is" and "as available" basis.
            To the maximum extent permitted by law, Munglabs disclaims all
            warranties, whether express, implied, or statutory, including the
            implied warranties of merchantability, fitness for a particular
            purpose, and non-infringement. We do not guarantee that the Service
            will be uninterrupted, secure, or error-free.
          </p>

          <h2>8. Limitation of liability</h2>
          <p>
            To the maximum extent permitted by law, Munglabs and its
            contributors shall not be liable for any indirect, incidental,
            special, consequential, or punitive damages, or any loss of
            profits, revenues, data, or goodwill, arising from or related to
            your use of (or inability to use) the Service, even if advised of
            the possibility of such damages.
          </p>

          <h2>9. Termination</h2>
          <p>
            We may suspend or terminate your access to the Service at any time,
            with or without cause, and with or without notice. You may stop
            using the Service and delete your account at any time by contacting
            us.
          </p>

          <h2>10. Changes to these terms</h2>
          <p>
            We may modify these Terms from time to time. The "Last updated"
            date above reflects the most recent revision. Your continued use of
            the Service after changes take effect constitutes acceptance of the
            revised Terms.
          </p>

          <h2>11. Governing law</h2>
          <p>
            These Terms are governed by the laws of the jurisdiction in which
            Munglabs is established, without regard to conflict-of-law rules.
            Any dispute arising under these Terms shall be subject to the
            exclusive jurisdiction of the courts of that jurisdiction.
          </p>

          <h2>12. Contact</h2>
          <p>
            Questions about these Terms? Contact us at
            <a href="mailto:contact@munglabs.com">contact@munglabs.com</a>.
          </p>
        </div>
      </div>
    </article>
  </main>
  <Footer links={footerLinks} />
</BaseLayout>
